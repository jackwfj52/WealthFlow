{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WealthFlow",
  "version": "2.0.0",
  "identifier": "com.jack.wealthflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/server"]
  },
  "security": {
    "csp": null
  }
}
